# ---- App ----
APP_NAME=FastAPI Scaffold
DEBUG=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Database ----
# Zero-config default: runs out of the box with SQLite (needs aiosqlite).
DATABASE_URL=sqlite+aiosqlite:///./app.db
# MySQL (uncomment the line below AND install aiomysql):
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/fastapi_scaffold
# Set to false in production and manage schema with `alembic upgrade head`.
CREATE_TABLES_ON_STARTUP=true

# ---- CORS (comma-separated allowed origins) ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Optional: auto-create a superuser on startup ----
# FIRST_SUPERUSER_EMAIL=admin@example.com
# FIRST_SUPERUSER_PASSWORD=changeme
